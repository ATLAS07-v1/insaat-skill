{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATLAS07-v1/insaat-skill/manifest.schema.json",
  "title": "Construction AI Skill Set Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "language",
    "description",
    "repository",
    "skill_count",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "skill_count": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_index_item"
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_limits": {
      "type": "object",
      "required": [
        "max_input_size_mb",
        "max_output_size_mb",
        "recommended_memory_mb"
      ],
      "properties": {
        "max_input_size_mb": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_size_mb": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_memory_mb": {
          "type": "integer",
          "minimum": 128
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "type",
        "path",
        "command"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "cli"
          ]
        },
        "path": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "skill_index_item": {
      "type": "object",
      "required": [
        "name",
        "version",
        "path",
        "manifest",
        "entrypoint",
        "display_name",
        "description",
        "python_requires",
        "dependency_groups",
        "system_tools",
        "tags",
        "triggers",
        "inputs",
        "outputs",
        "tools",
        "related_skills",
        "risk_level",
        "requires_human_approval",
        "sandbox_required",
        "execution_mode",
        "max_runtime_seconds",
        "network_access",
        "writes_files",
        "resource_limits"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "python_requires": {
          "type": "string"
        },
        "dependency_groups": {
          "$ref": "#/$defs/string_list"
        },
        "system_tools": {
          "$ref": "#/$defs/string_list"
        },
        "tags": {
          "$ref": "#/$defs/string_list"
        },
        "triggers": {
          "$ref": "#/$defs/string_list"
        },
        "inputs": {
          "$ref": "#/$defs/string_list"
        },
        "outputs": {
          "$ref": "#/$defs/string_list"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "related_skills": {
          "$ref": "#/$defs/string_list"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "requires_human_approval": {
          "type": "boolean"
        },
        "sandbox_required": {
          "type": "boolean"
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "analysis_only",
            "local_cli",
            "file_conversion",
            "external_application",
            "generates_script"
          ]
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "network_access": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "writes_files": {
          "type": "boolean"
        },
        "resource_limits": {
          "$ref": "#/$defs/resource_limits"
        }
      },
      "additionalProperties": false
    },
    "skill_manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "name",
        "version",
        "language",
        "display_name",
        "description",
        "entrypoint",
        "default_prompt",
        "python_requires",
        "dependency_groups",
        "system_tools",
        "tags",
        "triggers",
        "inputs",
        "outputs",
        "guardrails",
        "risk_level",
        "requires_human_approval",
        "human_approval_contexts",
        "sandbox_required",
        "execution_mode",
        "max_runtime_seconds",
        "network_access",
        "writes_files",
        "resource_limits",
        "tools",
        "related_skills"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "default_prompt": {
          "type": "string"
        },
        "python_requires": {
          "type": "string"
        },
        "dependency_groups": {
          "$ref": "#/$defs/string_list"
        },
        "system_tools": {
          "$ref": "#/$defs/string_list"
        },
        "tags": {
          "$ref": "#/$defs/string_list"
        },
        "triggers": {
          "$ref": "#/$defs/string_list"
        },
        "inputs": {
          "$ref": "#/$defs/string_list"
        },
        "outputs": {
          "$ref": "#/$defs/string_list"
        },
        "guardrails": {
          "$ref": "#/$defs/string_list"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "requires_human_approval": {
          "type": "boolean"
        },
        "human_approval_contexts": {
          "$ref": "#/$defs/string_list"
        },
        "sandbox_required": {
          "type": "boolean"
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "analysis_only",
            "local_cli",
            "file_conversion",
            "external_application",
            "generates_script"
          ]
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "network_access": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "writes_files": {
          "type": "boolean"
        },
        "resource_limits": {
          "$ref": "#/$defs/resource_limits"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "related_skills": {
          "$ref": "#/$defs/string_list"
        }
      },
      "additionalProperties": false
    }
  }
}
