{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Register",
  "type": "object",
  "required": ["evidence"],
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "properties": {
          "id": {"type": "string"},
          "requirement_id": {"type": "string"},
          "file": {"type": "string"},
          "status": {"type": "string"},
          "date": {"type": "string"},
          "source": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
